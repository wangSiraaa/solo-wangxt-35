{
  "name": "walkreach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke.cjs && node node_modules/.cache/smoke.cjs",
    "verify:td": "esbuild scripts/verify-td.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-td.cjs && node node_modules/.cache/verify-td.cjs"
  },
  "dependencies": {
    "graphology": "^0.25.4",
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/geojson": "^7946.0.14",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
